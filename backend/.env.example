# Copy to .env and fill in real values. Never commit .env.
#
# DATABASE_URL takes precedence over the individual DB_* fields below (see
# app/core/config.py). Use it for a hosted Postgres connection string (e.g.
# Neon) that needs query params like sslmode; use DB_* for local/dockerized
# Postgres where a plain host/port/user/password is enough.
DATABASE_URL=postgresql+psycopg2://neondb_owner:REPLACE_ME@REPLACE_ME.neon.tech/neondb?sslmode=require&channel_binding=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=soundbox

REDIS_HOST=localhost
REDIS_PORT=6379

# Signs JWT session tokens (app/core/security.py). Refuses to start in
# ENVIRONMENT=production if this is empty.
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# development | production. In production, main.py's startup check refuses
# to boot with default DB/RabbitMQ credentials or an empty SECRET_KEY.
ENVIRONMENT=development

# Creates the first admin user on a fresh database (no-op once any user
# exists — see app/db/helpers.py ensure_bootstrap_admin). Both required, no
# default: an empty pair means bootstrap is skipped, not "password".
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_FIRST_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD

# Frontend origins allowed to call this API cross-origin (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# NAMQR Code Standards v5.0, Annexure I "Signed QR": ECDSA P-256 public key
# used to verify a merchant's signed QR (tag 66) when the merchant has no
# key of its own on file (merchants.namqr_public_key_pem). Generate a
# keypair with backend/scripts/generate_namqr_keypair.py.
NAMQR_ORG_PUBLIC_KEY_PEM=
# false = unsigned QR is accepted with a warning (spec S1.7.7c); true
# rejects any QR without a valid signature.
NAMQR_REQUIRE_SIGNATURE=false

# Issued by Instant Payment Namibia (IPN) during WayaMe partner onboarding —
# these are third-party credentials, not something to generate locally.
WAYAME_API_BASE_URL=https://api.wayame.com.na/v1
WAYAME_CLIENT_ID=REPLACE_WITH_WAYAME_PARTNER_CLIENT_ID
WAYAME_CLIENT_SECRET=REPLACE_WITH_WAYAME_PARTNER_CLIENT_SECRET

# Powers POST /api/v1/analytics/ask (the dashboard "Ask anything" composer).
# Without this set, that endpoint returns 503 rather than failing silently.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Hosted Redis, for cached dashboard assembly and report generation.
# Format: redis://default:<password>@<host>:<port>
# Leave empty to use the local docker-compose redis service.
REDIS_URL=

# Event broker. Best-effort publishing: if this is unreachable, payments
# still complete and events are dropped. Set EVENTS_ENABLED=false to turn
# publishing off entirely.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
EVENTS_ENABLED=true
